import java.util.Scanner;

public class HalloPhil {

	public static void main(String[] args) {

		String input;
		Scanner scan = new Scanner(System.in);

		System.out.println("Hallo, Wer ist da ? :) ");
		input = scan.nextLine();
		System.out.println("Na " + input + " du schlingel :)");

		eliza();

	}

	public static void eliza() {
		System.out.println("Hallo mein Name ist Eliza");
	}
}

package aufgabe4;

import aufgabe2.Basic;

public class Ping extends Basic {

	private int radius = 20;

	private int directionX = 0;
	private int directionY = 0;

	private double geschX = 1;
	private double geschY = 2;

	public Ping() {
		setRadius(radius);
	}

	public void act() {

		if (directionX % 2 == 0) {
			if ((getX() + getRadius()) <= getWorld().getMaxX()) {
				setX(getX() + geschX);
			} else {
				directionX++;
				geschX = Math.random() + 1;
			}
		} else {
			if ((getX() - getRadius()) >= (getWorld().getMinX())) {
				setX(getX() - geschX);
			} else {
				directionX++;
				geschX = Math.random() + 1;
			}
		}

		if (directionY % 2 == 0) {
			if ((getY() + getRadius()) <= getWorld().getMaxY()) {
				setY(getY() + geschY);
			} else {
				directionY++;
				geschY = Math.random() + 1;
			}
		} else {
			if ((getY() - getRadius()) >= (getWorld().getMinY())) {
				setX(getY() - geschY);
			} else {
				directionY++;
				geschY = Math.random() + 1;
			}
		}

	}
}

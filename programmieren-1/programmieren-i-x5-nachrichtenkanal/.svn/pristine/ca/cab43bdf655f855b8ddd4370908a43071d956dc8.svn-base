import cs101.lang.Animate;

public class Receiver implements Animate {

	TextContainerPrototype chnl;
	TextGUI gui;

	public Receiver(TextContainerPrototype chnl) {
		this.chnl = chnl;
		gui = new TextGUI();
	}

	@Override
	public void act() {

		if (!chnl.empty()) {
			try {
				gui.write(chnl.remove());
			} catch (EmptyException e) {
				e.printStackTrace();
			} catch (NullPointerException x) {
				// Falls Receiver vor Sender initialisiert wird
			}
		}
	}
}

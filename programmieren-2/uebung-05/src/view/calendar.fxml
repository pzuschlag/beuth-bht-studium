				</Menu>
			</menus>
		</MenuBar>
	</top>
	<center>
      <VBox>
         <children>
						<Pane prefHeight="58.0" prefWidth="131.0">
               <children>
                  <ImageView fitHeight="60.0" fitWidth="130.0" layoutX="259.0" layoutY="-1.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../resources/images/unicorn.png" />

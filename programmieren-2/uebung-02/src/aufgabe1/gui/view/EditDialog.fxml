<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.control.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="180.0" prefWidth="290.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="aufgabe1.view.EditDialogController">
   <children>
      <GridPane layoutX="10.0" layoutY="6.0" prefHeight="139.0" prefWidth="271.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Vorname" />
            <Label text="Nachname" GridPane.rowIndex="1" />
            <Label text="Nummer" GridPane.rowIndex="2" />
            <Label text="E-Mail" GridPane.rowIndex="3" />
            <Label text="Addresse" GridPane.rowIndex="4" />
            <TextField fx:id="firstNameField" GridPane.columnIndex="1" />
            <TextField fx:id="lastNameField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="nummerField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <TextField fx:id="mailField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <TextField fx:id="addressField" GridPane.columnIndex="1" GridPane.rowIndex="4" />
         </children>
      </GridPane>
      <Button layoutX="147.0" layoutY="149.0" mnemonicParsing="false" onAction="#clickOk" prefHeight="26.0" prefWidth="60.0" text="OK" />
      <Button layoutX="220.0" layoutY="149.0" mnemonicParsing="false" onAction="#clickCancel" prefHeight="26.0" prefWidth="60.0" text="Cancel" />
   </children>
</AnchorPane>
